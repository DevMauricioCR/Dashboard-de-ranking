# Copia este archivo como .env y reemplaza con tus URLs reales de N8N.
# Usa este endpoint cuando n8n retorne el dataset crudo de HubSpot:
# [{ dealId, dealName, amount, dealStage, owner, contacts, lineItems, ... }]
VITE_WEBHOOK_DATASET=https://TU-N8N.com/webhook/hubspot-deals-dataset

# Variables antiguas: se conservan como fallback mientras migras.
VITE_WEBHOOK_RANKING=https://TU-N8N.com/webhook/ranking-asesores
VITE_WEBHOOK_LEADS=https://TU-N8N.com/webhook/leads-contactados
VITE_WEBHOOK_PRODUCTO=https://TU-N8N.com/webhook/ranking-producto
VITE_API_KEY=tu_clave_secreta_aqui

# Intervalo del poll de fondo 'mensual' que alimenta el reloj del topbar
# (milisegundos). Las pantallas de Día/Mes ya tienen su propio refresco (5 min / 1
# hora); esto solo es para "Actualizado hace Xs". 3600000 = 1 hora.
VITE_REFRESH_INTERVAL=3600000

# Opcionales: solo hace falta si no quieres derivar la URL de VITE_N8N_BASE_URL.
VITE_WEBHOOK_VENTA_ANUAL=https://TU-N8N.com/webhook/venta-anual-ranking
VITE_WEBHOOK_VENTAS_WEB=https://TU-N8N.com/webhook/ventas-web-diegodiaz
